# Bus tracking API — replace with your LocoNav API URL
BUS_API_URL=BUS_API_URL

# Home geo-fence (set to your home coordinates)
# Tip: Google Maps → long-press your home → copy coordinates
HOME_LAT=""
HOME_LONG=""
GEOFENCE_RADIUS_KM=""

# Poll interval in seconds
POLL_INTERVAL_SECONDS=10
REPEAT_ALERT_INTERVAL=3

# Max minutes the app runs
MAX_RUNTIME_MINUTES=30

# Telegram Bot (get token from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ntfy.sh push notification (rings your phone — install ntfy app and subscribe to this topic)
# Choose any unique topic name — e.g. my-bus-alert-abc123 (keep it hard to guess)
NTFY_TOPIC=my-topcic
MAX_ALERTS=15

# Email (SMTP) — Gmail example below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=PORT
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_app_password_here
ALERT_EMAIL_TO=you@gmail.com
